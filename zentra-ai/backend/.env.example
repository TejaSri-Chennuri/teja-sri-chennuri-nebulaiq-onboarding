# Database
DATABASE_URL=postgresql://zentra:zentra_pass@localhost:5432/zentra_db

# App Security
SECRET_KEY=change-this-to-a-secure-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis (for Celery background tasks)
REDIS_URL=redis://localhost:6379/0

# Gmail API (optional - enables email scanning)
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/api/auth/gmail/callback

# Plaid API (optional - enables bank transaction scanning)
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox

# Twilio (optional - enables SMS/WhatsApp notifications)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+1234567890

# SendGrid (optional - enables email notifications)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@zentra.ai

# Firebase (optional - enables push notifications)
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-credentials.json

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Debug mode (set to False in production)
DEBUG=True
